# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta WhatsApp Cloud API — developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_VERIFY_TOKEN=choose-any-string-you-also-enter-in-the-meta-webhook-config
WHATSAPP_APP_SECRET=your-meta-app-secret

# The actual WhatsApp number respondents message, in international format with no
# leading +, spaces, or dashes (e.g. 2348012345678). Used to build wa.me share links.
# This is NOT the same value as WHATSAPP_PHONE_NUMBER_ID above.
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# Full site URL once deployed (e.g. https://your-site.netlify.app). Used to render
# the webhook URL on the Settings page. Safe to leave as localhost during development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
